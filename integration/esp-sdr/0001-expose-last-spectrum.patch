--- a/main/targets/esp32s3/receiver.c
+++ b/main/targets/esp32s3/receiver.c
@@ -21,6 +21,7 @@
 #include "burst_serial.h"
 #include "rx_tuning.h"
 #include "ring_capture.h"
+#include "s3_local_spec.h"
 
 /* Vendor S3 adctrig uses the 64 KiB aperture at 0x3fcd0000 (MAC_DUMP_USAGE=4).
  * The continuous ring also uses the two banks below it. Keep all three, in
@@ -385,6 +386,49 @@ static void handle_command(char *line) {
         else reply("ERR command\n");
 }
 
+bool s3_local_spec_init(void) {
+    wifi_init_config_t cfg = WIFI_INIT_CONFIG_DEFAULT();
+    if (esp_wifi_init(&cfg) != ESP_OK ||
+        esp_wifi_set_storage(WIFI_STORAGE_RAM) != ESP_OK ||
+        esp_wifi_set_mode(WIFI_MODE_NULL) != ESP_OK ||
+        esp_wifi_start() != ESP_OK ||
+        esp_wifi_set_ps(WIFI_PS_NONE) != ESP_OK ||
+        esp_wifi_set_promiscuous(true) != ESP_OK ||
+        esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE) != ESP_OK) {
+        return false;
+    }
+    prepare_rx();
+    ring_capture_init();
+    return true;
+}
+
+bool s3_capture_local_spec(unsigned duration_ms, unsigned rate, unsigned nfft,
+                           const uint8_t **frame, size_t *length) {
+    if (frame == NULL || length == NULL || duration_ms == 0 || duration_ms > 1000 ||
+        (rate != 0 && rate != 1 && rate != 6) || !ring_capture_valid_nfft(nfft)) {
+        return false;
+    }
+    *frame = NULL;
+    *length = 0;
+    ring_config_t config = {
+        .mode = RING_MODE_SPEC,
+        .rate = rate,
+        .duration_ms = duration_ms,
+        .nfft = nfft,
+        .stride = 2,
+        .units_per_frame = 1,
+        .local_only = true,
+    };
+    ring_result_t result;
+    prepare_rx();
+    rx_filter_apply();
+    ring_capture_run(&config, &result);
+    rx_filter_restore();
+    return result.status == RING_OK && result.frames > 0 &&
+           ring_capture_last_spec(frame, length);
+}
+
