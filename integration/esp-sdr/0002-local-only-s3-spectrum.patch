diff --git a/main/esp_sdr_local.h b/main/esp_sdr_local.h
new file mode 100644
--- /dev/null
+++ b/main/esp_sdr_local.h
@@ -0,0 +1,17 @@
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "sdkconfig.h"
+
+#if CONFIG_IDF_TARGET_ESP32S3
+/*
+ * Capture one bounded, local-only 256-bin spectrum frame.
+ *
+ * Wi-Fi/PHY initialization and transition to WIFI_MODE_NULL must already have
+ * been performed by the embedding application.
+ */
+bool esp_sdr_s3_local_spec(uint32_t frequency_mhz, uint32_t duration_ms,
+                           const uint8_t **frame, size_t *length);
+#endif
diff --git a/main/targets/esp32s3/receiver.c b/main/targets/esp32s3/receiver.c
--- a/main/targets/esp32s3/receiver.c
+++ b/main/targets/esp32s3/receiver.c
@@ -22,6 +22,7 @@
 #include "burst_serial.h"
+#include "esp_sdr_local.h"
 #include "rx_tuning.h"
 #include "ring_capture.h"
@@ -226,6 +227,35 @@ static void ring_send_capture(const ring_result_t *r,unsigned rate) {
     }
 }
+
+bool esp_sdr_s3_local_spec(uint32_t mhz, uint32_t duration_ms,
+                           const uint8_t **frame, size_t *length) {
+    if (!frame || !length || !duration_ms || duration_ms > 1000u ||
+        mhz < S3_FREQ_MIN || mhz > S3_FREQ_MAX) return false;
+
+    frequency_mhz=mhz;
+    rx_ready=false;
+    prepare_rx();
+    ring_capture_init();
+
+    ring_config_t c={
+        .mode=RING_MODE_SPEC,
+        .rate=6,                 /* 16 MS/s */
+        .duration_ms=duration_ms,
+        .nfft=256,
+        .stride=2,
+        .units_per_frame=1,
+        .max_hold=false,
+        .stats=false,
+        .local_only=true,
+    };
+    ring_result_t result;
+    rx_filter_apply();
+    ring_capture_run(&c,&result);
+    rx_filter_restore();
+    if (result.status || !result.frames) return false;
+    return ring_capture_last_spec(frame,length);
+}
